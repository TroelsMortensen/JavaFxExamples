<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="extraterrestrialexploration.presentation.controllers.alienmanagement.ListAliensController"
      spacing="16" styleClass="card">

    <Label text="Aliens" styleClass="view-title"/>

    <TableView fx:id="aliensTable" prefHeight="360">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="150"/>
            <TableColumn fx:id="speciesColumn" text="Species" prefWidth="150"/>
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="280"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="Add" onAction="#handleAdd" styleClass="primary-button"/>
        <Button text="Show" onAction="#handleShow" styleClass="secondary-button"/>
        <Button text="Update" onAction="#handleUpdate" styleClass="secondary-button"/>
        <Button text="Delete" onAction="#handleDelete" styleClass="danger-button"/>
    </HBox>

    <Label fx:id="messageLabel"/>
</VBox>
