<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="extraterrestrialexploration.presentation.controllers.encountermanagement.ListEncountersController"
      spacing="16" styleClass="card">

    <Label text="Encounters" styleClass="view-title"/>

    <TableView fx:id="encountersTable" prefHeight="360">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="110"/>
            <TableColumn fx:id="alienColumn" text="Alien" prefWidth="140"/>
            <TableColumn fx:id="planetColumn" text="Planet" prefWidth="140"/>
            <TableColumn fx:id="explorerColumn" text="Explorer" prefWidth="140"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="Add" onAction="#handleAdd" styleClass="primary-button"/>
        <Button text="Show" onAction="#handleShow" styleClass="secondary-button"/>
        <Button text="Update" onAction="#handleUpdate" styleClass="secondary-button"/>
        <Button text="Delete" onAction="#handleDelete" styleClass="danger-button"/>
    </HBox>

    <Label fx:id="messageLabel"/>
</VBox>
