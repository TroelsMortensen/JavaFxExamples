<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="extraterrestrialexploration.presentation.controllers.planetmanagement.ListPlanetsController"
      spacing="16" styleClass="card">

    <Label text="Planets" styleClass="view-title"/>

    <TableView fx:id="planetsTable" prefHeight="360">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="140"/>
            <TableColumn fx:id="climateColumn" text="Climate" prefWidth="220"/>
            <TableColumn fx:id="distanceColumn" text="Distance (AU)" prefWidth="120"/>
            <TableColumn fx:id="atmosphereColumn" text="Atmosphere" prefWidth="100"/>
            <TableColumn fx:id="lifeColumn" text="Life" prefWidth="80"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="Add" onAction="#handleAdd" styleClass="primary-button"/>
        <Button text="Show" onAction="#handleShow" styleClass="secondary-button"/>
        <Button text="Update" onAction="#handleUpdate" styleClass="secondary-button"/>
        <Button text="Delete" onAction="#handleDelete" styleClass="danger-button"/>
    </HBox>

    <Label fx:id="messageLabel"/>
</VBox>
